<.header>
  Page {@page.number} of story {@story.name}
  <:actions>
    <div class="flex items-center gap-2">
      <JapaneseWeb.RecentWords.open_button />
      <.link href={~p"/stories/#{@story.name}/#{@page.number}/japanese"}>
        <.button>View Original Japanese</.button>
      </.link>
    </div>
  </:actions>
</.header>

<JapaneseWeb.RecentWords.dialog />

<%!-- Keyboard shortcuts (E: toggle English, D: JPDB lookup of the
     highlighted Japanese, J/K: scroll down/up). See Hooks.StoryShortcuts
     in app.js. --%>
<div
  id="story-shortcuts"
  phx-hook="StoryShortcuts"
  data-root="#story-container"
  data-scroll="#story-scroll-container"
  hidden
>
</div>

<div id="story-container" phx-hook="TextSelection" class="relative flex flex-col h-[60vh] mt-8">
  <div
    id="story-scroll-container"
    phx-hook="ScrollPosition"
    class="flex-1 overflow-y-auto rounded border p-4 bg-white dark:bg-zinc-900 shadow"
  >
    <%= case @translation_status do %>
      <% :in_progress -> %>
        <div class="flex items-center justify-center py-8 text-zinc-600 dark:text-zinc-400">
          <svg class="animate-spin h-6 w-6 mr-3" viewBox="0 0 24 24">
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
              fill="none"
            />
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            />
          </svg>
          <span>Translating...</span>
        </div>
      <% {:error, reason} -> %>
        <div class="flex flex-col items-center justify-center py-8">
          <div class="text-red-600 dark:text-red-400 mb-4">
            {JapaneseWeb.TranslationErrors.translation_message(reason)}
          </div>
          <button
            phx-click="retry_translation"
            class="rounded bg-blue-600 text-white px-4 py-2 hover:bg-blue-700"
            type="button"
          >
            Retry Translation
          </button>
        </div>
      <% _ -> %>
        <.translation id="translation-display" content={@translation} />
    <% end %>
  </div>
  <!-- Action buttons container - vertical on mobile, horizontal on desktop -->
  <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-4 md:flex-row-reverse">
    <!-- Toggle English - bottom on mobile, rightmost on desktop (most common) -->
    <button
      onclick="toggleVisibilityByClass('tr-eng')"
      class="rounded-full bg-zinc-900 dark:bg-zinc-700 text-white px-6 py-3 shadow-lg hover:bg-zinc-700 dark:hover:bg-zinc-600 focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
      type="button"
      title="Toggle English (E)"
      aria-keyshortcuts="E"
    >
      Toggle English <.shortcut_key key="E" />
    </button>
    <!-- JPDB button - middle on mobile, center on desktop, hidden for long text -->
    <button
      :if={@selected_text && !@explanation}
      id="jpdb-button"
      type="button"
      class="rounded-full bg-blue-600 text-white px-6 py-3 shadow-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-400 transition text-center"
      title="Look up on JPDB (D)"
      aria-keyshortcuts="D"
    >
      JPDB <.shortcut_key key="D" />
    </button>
    <!-- Explain button - top on mobile, leftmost on desktop -->
    <button
      :if={@selected_text && !@explaining && !@explanation}
      id="explain-button"
      class="rounded-full bg-green-600 text-white px-6 py-3 shadow-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-400 transition"
      type="button"
    >
      Explain
    </button>
    <!-- Cancel button - same position as Explain -->
    <button
      :if={@explaining}
      phx-click="cancel_explain"
      class="rounded-full bg-orange-500 text-white px-6 py-3 shadow-lg hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-400 transition"
      type="button"
    >
      Cancel...
    </button>
  </div>
</div>

<.back navigate={~p"/stories/#{@story}"}>Back to story</.back>

<.modal
  :if={@explanation}
  id="explanation-modal"
  show
  on_cancel={JS.push("close_explanation_modal")}
>
  <div class="space-y-4">
    <h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Explanation</h3>
    <div class="markdown-content text-zinc-700 dark:text-zinc-300 leading-relaxed space-y-3">
      {Phoenix.HTML.raw(@explanation)}
    </div>
    <div
      :for={{followup, i} <- Enum.with_index(@followups)}
      id={"followup-#{i}"}
      class="space-y-2 pt-4 border-t border-zinc-200 dark:border-zinc-700"
    >
      <p class="font-medium text-zinc-900 dark:text-zinc-100">{followup.question}</p>
      <div
        :if={followup.html}
        class="markdown-content text-zinc-700 dark:text-zinc-300 leading-relaxed space-y-3"
      >
        {Phoenix.HTML.raw(followup.html)}
      </div>
      <p :if={followup.error} class="text-sm text-red-600 dark:text-red-400">
        {followup.error}
      </p>
      <p
        :if={is_nil(followup.html) and is_nil(followup.error)}
        class="text-sm italic text-zinc-500 dark:text-zinc-400"
      >
        Thinking…
      </p>
    </div>
    <form
      :if={@explain_markdown}
      id="followup-form"
      phx-submit="ask_followup"
      class="flex gap-2"
    >
      <%!-- A new input per answered question, so it is cleared and (after the
           first) focused, ready for the next one without the mouse. --%>
      <input
        id={"followup-question-#{Enum.count(@followups, &(&1.html || &1.error))}"}
        phx-mounted={@followups != [] && JS.focus()}
        type="text"
        name="question"
        autocomplete="off"
        placeholder="Ask a follow-up…"
        disabled={@followup_task != nil}
        class="flex-1 rounded-lg border border-zinc-300 dark:border-zinc-600 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 disabled:opacity-50"
      />
      <button
        type="submit"
        disabled={@followup_task != nil}
        class="rounded-lg bg-green-600 text-white px-4 py-2 text-sm shadow hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-400 disabled:opacity-50"
      >
        Ask
      </button>
    </form>
    <div class="flex justify-end pt-4 border-t border-zinc-200 dark:border-zinc-700">
      <button
        phx-click="close_explanation_modal"
        class="rounded-lg bg-zinc-900 dark:bg-zinc-700 text-white px-6 py-2 shadow hover:bg-zinc-700 dark:hover:bg-zinc-600 focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
        type="button"
      >
        Okay
      </button>
    </div>
  </div>
</.modal>
