<div class="flex items-center justify-between gap-4 text-sm">
  <.link navigate={~p"/stories"} class="text-zinc-500 hover:text-zinc-800">&larr; Stories</.link>
  <span
    id="deck-status"
    class={[
      "rounded-full px-3 py-1",
      match?({:connected, _}, @deck_status) && "bg-green-100 text-green-800",
      !match?({:connected, _}, @deck_status) && "bg-zinc-100 text-zinc-600"
    ]}
  >
    {deck_label(@deck_status)}
  </span>
</div>

<div
  :if={@arrived}
  id="arrived-banner"
  class="mt-4 flex items-center gap-3 rounded border border-amber-300 bg-amber-50 px-4 py-2 text-sm text-amber-900"
>
  <span class="flex-1">
    New screenshot: {@arrived.description || status_label(@arrived.status) || @arrived.file}
  </span>
  <.link patch={~p"/game/#{@arrived.id}"} class="font-semibold underline">View</.link>
  <button
    phx-click="dismiss_arrived"
    type="button"
    class="text-amber-700 hover:text-amber-900"
    aria-label="Dismiss"
  >
    &times;
  </button>
</div>

<%= if @shot do %>
  <% {older, newer} = neighbours(@shots, @shot) %>
  <div class="mt-6">
    <div class="text-sm text-zinc-500">
      {@shot.game || "App #{@shot.appid}"} · {@shot.taken_at || @shot.file}
    </div>
    <h1 id="shot-description" class="text-xl font-semibold text-zinc-900">
      {@shot.description || status_label(@shot.status) || @shot.file}
    </h1>
  </div>

  <div class="mt-3 flex items-center gap-2 text-sm">
    <.link
      :if={older}
      id="older-shot"
      patch={~p"/game/#{older.id}"}
      class="rounded border px-3 py-1 hover:bg-zinc-50"
    >
      &larr; Older
    </.link>
    <span :if={!older} class="rounded border px-3 py-1 text-zinc-300">&larr; Older</span>
    <.link
      :if={newer}
      id="newer-shot"
      patch={~p"/game/#{newer.id}"}
      class="rounded border px-3 py-1 hover:bg-zinc-50"
    >
      Newer &rarr;
    </.link>
    <span :if={!newer} class="rounded border px-3 py-1 text-zinc-300">Newer &rarr;</span>

    <details id="shot-list" class="relative ml-auto">
      <summary class="cursor-pointer rounded border px-3 py-1 hover:bg-zinc-50">
        All shots ({length(@shots)})
      </summary>
      <ul class="absolute right-0 z-40 mt-1 max-h-96 w-80 overflow-y-auto rounded border bg-white shadow-lg">
        <li :for={s <- @shots} class={[s.id == @shot.id && "bg-blue-50"]}>
          <.link patch={~p"/game/#{s.id}"} class="block px-3 py-2 hover:bg-zinc-50">
            <div class="text-xs text-zinc-500">
              {s.taken_at} · {s.game || "App #{s.appid}"}
              <span :if={status_label(s.status)} class="text-amber-700">
                · {status_label(s.status)}
              </span>
            </div>
            <div class="text-sm text-zinc-900">{s.description || s.file}</div>
          </.link>
        </li>
      </ul>
    </details>
  </div>

  <div
    id={"game-text-#{@shot.id}"}
    phx-hook="TextSelection"
    class="game-text relative mt-4 rounded border bg-white p-4 shadow"
  >
    <%= case @shot.status do %>
      <% status when status in [:pending, :processing] -> %>
        <div class="flex items-center justify-center py-8 text-zinc-600">
          <svg class="animate-spin h-6 w-6 mr-3" viewBox="0 0 24 24">
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
              fill="none"
            />
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            />
          </svg>
          <span>Reading the screenshot…</span>
        </div>
      <% :error -> %>
        <div class="flex flex-col items-center justify-center py-8">
          <div class="text-red-600 mb-4">Failed: {@shot.error}</div>
          <button
            phx-click="retry_shot"
            class="rounded bg-blue-600 text-white px-4 py-2 hover:bg-blue-700"
            type="button"
          >
            Retry
          </button>
        </div>
      <% :done -> %>
        <div :if={@shot.sections == []} class="py-8 text-center text-zinc-500">
          No text found in this screenshot.
        </div>
        <div :if={@shot.pointer} class="g-eng mb-4 text-sm text-zinc-500">
          Pointer: {@shot.pointer}
        </div>
        <section :for={section <- @shot.sections} class="mb-6 last:mb-0">
          <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-zinc-400">
            {section["name"]}<span :if={section["speaker"]} class="normal-case text-zinc-600"> · {section[
              "speaker"
            ]}</span>
          </h2>
          <div :if={section["labels"] != []} class="mb-2 flex flex-wrap gap-1">
            <span
              :for={label <- section["labels"]}
              class={[
                "rounded px-2 py-0.5 text-xs",
                label == section["focused_label"] &&
                  "bg-amber-100 text-amber-900 ring-1 ring-amber-400",
                label != section["focused_label"] && "bg-zinc-100 text-zinc-600"
              ]}
            >
              {label}
            </span>
          </div>
          <div
            :for={line <- section["lines"]}
            class={[
              "mb-3 border-l-4 pl-3",
              line["focused"] && "border-amber-400 bg-amber-50",
              !line["focused"] && "border-transparent"
            ]}
          >
            <div class="tr-ja font-serif text-lg">{line["ja"]}</div>
            <div :if={line["reading"]} class="g-kana text-sm text-purple-800">
              {line["reading"]}
            </div>
            <div
              :if={line["en"]}
              class="g-eng mt-1 rounded border border-blue-200 bg-blue-50 p-2 text-blue-900"
            >
              {line["en"]}
            </div>
            <div
              :if={line["unverified"] || line["ocr_note"] || line["ocr_missed"]}
              class="mt-1 text-xs italic text-zinc-400"
            >
              {cond do
                line["ocr_note"] -> "Note: #{line["ocr_note"]}"
                line["ocr_missed"] -> "OCR missed this; read from the image"
                true -> "not confirmed by OCR"
              end}
            </div>
          </div>
        </section>
    <% end %>

    <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-4 md:flex-row-reverse">
      <button
        id="toggle-english"
        phx-click={JS.toggle_class("show-eng", to: ".game-text")}
        class="rounded-full bg-zinc-900 text-white px-6 py-3 shadow-lg hover:bg-zinc-700 focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
        type="button"
      >
        Toggle English
      </button>
      <button
        id="toggle-kana"
        phx-click={JS.toggle_class("show-kana", to: ".game-text")}
        class="rounded-full bg-purple-900 text-white px-6 py-3 shadow-lg hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-400 transition"
        type="button"
      >
        Toggle Kana
      </button>
      <button
        :if={@selected_text && !@explanation}
        id="jpdb-button"
        type="button"
        class="rounded-full bg-blue-600 text-white px-6 py-3 shadow-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-400 transition text-center"
      >
        JPDB
      </button>
      <button
        :if={@selected_text && !@explaining && !@explanation}
        id="explain-button"
        class="rounded-full bg-green-600 text-white px-6 py-3 shadow-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-400 transition"
        type="button"
      >
        Explain
      </button>
      <button
        :if={@explaining}
        phx-click="cancel_explain"
        class="rounded-full bg-orange-500 text-white px-6 py-3 shadow-lg hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-400 transition"
        type="button"
      >
        Cancel...
      </button>
    </div>
  </div>
  <div class="h-40"></div>
<% else %>
  <div id="no-shots" class="mt-16 text-center text-zinc-500">
    <p>No screenshots yet.</p>
    <p class="mt-2 text-sm">
      Take one on the Deck with Steam + R1 and it will show up here.
    </p>
  </div>
<% end %>

<.modal
  :if={@explanation}
  id="explanation-modal"
  show
  on_cancel={JS.push("close_explanation_modal")}
>
  <div class="space-y-4">
    <h3 class="text-lg font-semibold text-zinc-900">Explanation</h3>
    <div class="markdown-content text-zinc-700 leading-relaxed space-y-3">
      {Phoenix.HTML.raw(@explanation)}
    </div>
    <div class="flex justify-end pt-4 border-t border-zinc-200">
      <button
        phx-click="close_explanation_modal"
        class="rounded-lg bg-zinc-900 text-white px-6 py-2 shadow hover:bg-zinc-700 focus:outline-none focus:ring-2 focus:ring-blue-400 transition"
        type="button"
      >
        Okay
      </button>
    </div>
  </div>
</.modal>
