<%!-- Little top padding on phones, where it is dead space above the page
     header; bottom padding stays so the floating buttons don't cover the end
     of the page. --%>
<main class="px-4 pt-4 pb-20 sm:px-6 sm:pt-20 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
